# Ilmvers Institute. Copy to .env.local and fill in real values.
# Do not commit .env.local. Do not reuse another school's project, buckets, or domains.

# ─── Supabase (a new Ilmvers project, not an existing one) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ilmversinstitute.com
EMAIL_FROM=Ilmvers Institute <noreply@ilmversinstitute.com>
ADMIN_ALERT_EMAIL=info@ilmversinstitute.com

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Localhost uses Cloudflare's public test key automatically.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Resend (verified ilmversinstitute.com domain) ───────────────────────────
RESEND_API_KEY=
NEWSLETTER_UNSUBSCRIBE_SECRET=

# ─── Payments ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_KEY=
NEXT_PUBLIC_FLUTTERWAVE_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
NEXT_PUBLIC_PAYSTACK_PLAN_GROUP=
NEXT_PUBLIC_PAYSTACK_PLAN_ONETOONE=
NEXT_PUBLIC_PAYSTACK_PLAN_IJAZAH=
NEXT_PUBLIC_PAYSTACK_PLAN_HIFDH=
NEXT_PUBLIC_FLUTTERWAVE_PLAN_GROUP=
NEXT_PUBLIC_FLUTTERWAVE_PLAN_ONETOONE=
NEXT_PUBLIC_FLUTTERWAVE_PLAN_IJAZAH=
NEXT_PUBLIC_FLUTTERWAVE_PLAN_HIFDH=

# ─── Assessment calendar (Calendly event URL, no query string) ───────────────
NEXT_PUBLIC_CALENDLY_URL=

# ─── Live classroom (8x8 JaaS). Leave blank until the Ilmvers app exists. ──
NEXT_PUBLIC_JAAS_APP_ID=
NEXT_PUBLIC_CLASSROOM_TOKEN_URL=

# ─── Cron (same value as `wrangler secret put CRON_SECRET`) ──────────────────
CRON_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
OPENAI_API_KEY=
# Hifz Lab stays off. Set the public flag to "true" only after a separate grader exists.
NEXT_PUBLIC_HIFZ_LAB_ENABLED=false
HIFZ_SCORING_URL=
HIFZ_SCORING_TOKEN=

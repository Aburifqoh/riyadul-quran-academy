# Environment variables needed for production (Ilmvers Institute)
# Copy this file to .env.local and fill in the actual values.
# Do NOT commit .env.local to version control.

# ─── Supabase (Database & Auth) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Payment Gateways (Public Keys)
NEXT_PUBLIC_PAYSTACK_KEY=pk_live_xxxx
NEXT_PUBLIC_FLUTTERWAVE_KEY=FLWPUBK-xxxx

# Payment Gateways (Secret Keys for Webhooks/Server)
PAYSTACK_SECRET_KEY=sk_live_xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxx
FLUTTERWAVE_SECRET_HASH=your-secure-hash

# Cron Secret for Daily Billing
CRON_SECRET=my-super-secret-cron-key

# Payment Plan Codes (Create these in your Paystack/Flutterwave Dashboard)
# For Paystack, use the Plan Code (e.g., PLN_gx2wn530m0i3w3m)
NEXT_PUBLIC_PAYSTACK_PLAN_GROUP=
NEXT_PUBLIC_PAYSTACK_PLAN_ONETOONE=
NEXT_PUBLIC_PAYSTACK_PLAN_IJAZAH=
NEXT_PUBLIC_PAYSTACK_PLAN_HIFDH=

# For Flutterwave, use the Plan ID (e.g., 4513)
NEXT_PUBLIC_FLUTTERWAVE_PLAN_GROUP=
NEXT_PUBLIC_FLUTTERWAVE_PLAN_ONETOONE=
NEXT_PUBLIC_FLUTTERWAVE_PLAN_IJAZAH=
NEXT_PUBLIC_FLUTTERWAVE_PLAN_HIFDH=

# ─── Resend (Transactional Email) ────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Ilmvers Institute <noreply@ilmversinstitute.com>"
ADMIN_ALERT_EMAIL="info@ilmversinstitute.com"
NEXT_PUBLIC_SITE_URL="https://ilmversinstitute.com"

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Localhost uses Cloudflare's public test key automatically.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Meta Ads Tracking (Pixel & Conversions API) ──────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=""
META_ACCESS_TOKEN=""
